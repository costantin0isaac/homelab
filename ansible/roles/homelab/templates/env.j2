# ===========================
# CADDY HOSTS
# ===========================
VIKUNJA_HOST={{ vikunja_host }}
GRAFANA_HOST={{ grafana_host }}
PROMETHEUS_HOST={{ prometheus_host }}
GITLAB_HOST={{ gitlab_host }}
GITLAB_REGISTRY_HOST={{ gitlab_registry_host }}
STIRLING_HOST={ {stirling_host }}
STATUS_HOST={{ status_host }}
PROXMOX_HOST={{ proxmox_host }}
ADGUARD_HOST={{ adguard_host }}

# ===========================
# URLS
# ===========================
VIKUNJA_DOMAIN=https://{{ vikunja_host }}/
GRAFANA_DOMAIN=https://{{ grafana_host }}/
PROMETHEUS_DOMAIN=https://{{ prometheus_host }}/
GITLAB_DOMAIN=https://{{ gitlab_host }}/
GITLAB_REGISTRY_DOMAIN=https://{{ gitlab_registry__host }}/
STRILING_DOMAIN=https://{{ stirling_host }}/

# ===========================
# IPs
# ===========================
GITLAB_IP={{ vault_gitlab_ip }}
PROXMOX_IP={{ vault_proxmox_ip }}
GITLAB_BACKEND={{ vault_gitlab_ip }}:80

# ===========================
# CLOUDFLARE
# ===========================
CF_API_TOKEN={{ vault_cf_api_token }}

# ===========================
# VIKUNJA
# ===========================
VIKUNJA_DB_USER={{ vault_vikunja_db_user }}
VIKUNJA_DB_PASSWORD={{ vault_vikunja_db_password }}
VIKUNJA_DB_NAME={{ vault_vikunja_db_name }}

# ===========================
# GRAFANA
# ===========================
GRAFANA_ADMIN_PASSWORD={{ vault_grafana_admin_password }}

# ===========================
# PROXMOX EXPORTER
# ===========================
PVE_USER={{ vault_pve_user }}
PVE_TOKEN_NAME={{ vault_pve_token_name }}
PVE_TOKEN_VALUE={{ vault_pve_token_value }}
PVE_VERIFY_SSL=false
