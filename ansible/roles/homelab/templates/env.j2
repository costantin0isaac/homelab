# ===========================
# CADDY HOSTS
# ===========================
VIKUNJA_HOST={{ vault_vikunja_host }}
GRAFANA_HOST={{ vault_grafana_host }}
PROMETHEUS_HOST={{ vault_prometheus_host }}
GITLAB_HOST={{ vault_gitlab_host }}
GITLAB_REGISTRY_HOST={{ vault_gitlab_registry_host }}
STIRLING_HOST={{ vault_stirling_host }}
STATUS_HOST={{ vault_status_host }}
PROXMOX_HOST={{ vault_proxmox_host }}
ADGUARD_HOST={{ vault_adguard_host }}

# ===========================
# URLS
# ===========================
VIKUNJA_DOMAIN=https://{{ vault_vikunja_host }}/
GRAFANA_DOMAIN=https://{{ vault_grafana_host }}/
PROMETHEUS_DOMAIN=https://{{ vault_prometheus_host }}/
GITLAB_DOMAIN=https://{{ vault_gitlab_host }}/
GITLAB_REGISTRY_DOMAIN=https://{{ vault_gitlab_registry_host }}/
STRILING_DOMAIN=https://{{ vault_stirling_host }}/

# ===========================
# BACKENDS
# ===========================
VIKUNJA_BACKEND={{ vault_vikunja_backend }}
GRAFANA_BACKEND={{ vault_grafana_backend }}
PROMETHEUS_BACKEND={{ vault_prometheus_backend }}
STIRLING_BACKEND={{ vault_stirling_backend }}
STATUS_BACKEND={{ vault_status_backend }}
GITLAB_BACKEND={{ vault_gitlab_backend }}
GITLAB_REGISTRY_BACKEND={{ vault_gitlab_registry_backend }}
PROXMOX_BACKEND={{ vault_proxmox_backend }}
ADGUARD_BACKEND={{ vault_adguard_backend }}

# ===========================
# IPs
# ===========================
GITLAB_IP={{ vault_gitlab_ip }}
PROXMOX_IP={{ vault_proxmox_ip }}
GITLAB_BACKEND={{ vault_gitlab_ip }}:80

# ===========================
# CLOUDFLARE
# ===========================
CF_ADMIN_EMAIL={{ vault_cf_admin_email }}
CF_API_TOKEN={{ vault_cf_api_token }}

# ===========================
# VIKUNJA
# ===========================
VIKUNJA_DB_USER={{ vault_vikunja_db_user }}
VIKUNJA_DB_PASSWORD={{ vault_vikunja_db_password }}
VIKUNJA_DB_NAME={{ vault_vikunja_db_name }}

# ===========================
# GRAFANA
# ===========================
GRAFANA_ADMIN_PASSWORD={{ vault_grafana_admin_password }}

# ===========================
# PROXMOX EXPORTER
# ===========================
PVE_USER={{ vault_pve_user }}
PVE_TOKEN_NAME={{ vault_pve_token_name }}
PVE_TOKEN_VALUE={{ vault_pve_token_value }}
PVE_VERIFY_SSL=false